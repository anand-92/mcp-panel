<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- DMG Distribution Entitlements (Non-Sandboxed for Sparkle updates) -->
    <!-- Note: App Store builds MUST use appstore.entitlements instead -->

    <!-- IMPORTANT: Sandboxing is DISABLED for DMG builds so Sparkle can replace
         the app bundle in /Applications. Sandboxed Sparkle would additionally
         require the Installer XPC service and mach-lookup exceptions. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Network access for downloading updates and checking the MCP registry -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File access for reading/writing config files chosen by the user -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- No hardened-runtime exceptions are declared on purpose: the app is pure
         Swift/SwiftUI with no JIT, no unsigned executable memory, and no plugin
         loading. Developer ID signing satisfies Sparkle's library validation, so
         disable-library-validation is only needed for ad-hoc local builds. -->
</dict>
</plist>
